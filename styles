body {
    font-family: sans-serif;
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

header {
    display: flex;
    flex: 1 1 0;
    justify-content: space-between;
    align-items: center;
}

footer {
    display: flex;
    flex: 1 1 0;
    justify-content: center;
    align-items: center;
    gap: 10px;
}

#content {
    display: flex;
    flex: 8 1 0;
    justify-content: center;
}

body > * {
    border: 2px solid red
}